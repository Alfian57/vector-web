# PostgreSQL dan Prisma untuk koneksi ke database VEKTOR.
POSTGRES_PASSWORD=replace_with_a_random_hex_password
DATABASE_URL=postgresql://vektor:replace_with_a_random_hex_password@db:5432/vektor

# Better Auth untuk origin aplikasi dan keamanan sesi.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters

# Token perangkat Fonnte untuk kode OTP melalui WhatsApp.
FONNTE_TOKEN=

# Web Push opsional untuk notifikasi perangkat.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Kunci opsional untuk layanan pelanggan Open-Meteo.
OPEN_METEO_API_KEY=

# Kunci browser opsional untuk peta online dan satelit MapTiler.
MAPTILER_API_KEY=
