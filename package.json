{
  "name": "vector-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "bun run db:generate",
    "dev": "bun run db:generate && bun run dev:prepare && next dev",
    "dev:all": "bun scripts/dev-all.ts",
    "dev:prepare": "bun scripts/prepare-map-worker.ts && bun scripts/build-worker.ts --dev",
    "build": "bun scripts/prepare-map-worker.ts && next build && bun scripts/build-worker.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test tests/unit",
    "test:integration": "bun scripts/test-integration.ts",
    "test:e2e": "playwright test",
    "test:fonnte": "bun tests/e2e/fonnte-stub.ts",
    "db:generate": "prisma generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:seed": "bun --env-file=.env.local run prisma db seed",
    "officer:grant": "bun scripts/officer.ts",
    "push:setup": "bun scripts/configure-push.ts",
    "worker": "bun scripts/worker.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@logtape/logtape": "^2.4.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tiptap/core": "^3.35.1",
    "@tiptap/extension-image": "^3.35.1",
    "@tiptap/extension-link": "^3.35.1",
    "@tiptap/extension-placeholder": "^3.35.1",
    "@tiptap/extension-text-style": "3.35.1",
    "@tiptap/pm": "^3.35.1",
    "@tiptap/react": "^3.35.1",
    "@tiptap/starter-kit": "^3.35.1",
    "@tiptap/static-renderer": "^3.35.1",
    "better-auth": "^1.7.28",
    "dexie": "^4.4.7",
    "lucide-react": "^1.80.0",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "pmtiles": "^4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "^6.2.5",
    "sharp": "^0.35.5",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "^1.4.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.5",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
